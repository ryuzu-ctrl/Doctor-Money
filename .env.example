# ===== Railway (1 service: API + dashboard + bot) =====
# Cukup isi variabel di bawah pada service aplikasi. Jangan commit .env.

# Bot Telegram: ambil dari @BotFather.
BOT_TOKEN=

# Secret acak minimal 32 karakter:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

# Di Railway pakai referensi ke service Postgres (format postgresql:// diterima otomatis):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Lokal tanpa Postgres boleh dikosongkan (memakai SQLite).
DATABASE_URL=

TZ=Asia/Jakarta

# ===== Opsional =====
# all (default) = API + bot polling dalam satu service; api = hanya API; bot = hanya bot.
APP_RUNTIME=all
# Kosongkan di Railway: otomatis memakai https://$RAILWAY_PUBLIC_DOMAIN.
# Harus domain yang menyajikan dashboard + /api (bukan Firebase Hosting).
WEBAPP_URL=
# Hanya untuk APP_RUNTIME=bot dengan MODE=webhook (domain service bot).
MODE=polling
WEBHOOK_URL=
# Railway mengisi PORT sendiri.
PORT=8080
# API key CoinGecko (bukan URL). Kosongkan bila tidak punya.
COINGECKO_API_KEY=
SUPPORT_URL=
