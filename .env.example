# Bot Telegram: ambil dari @BotFather.
BOT_TOKEN=

# URL Firebase Hosting untuk Mini App dan dashboard; juga menjadi origin CORS API.
WEBAPP_URL=https://YOUR_FIREBASE_PROJECT.web.app
# URL publik service API untuk webhook Telegram.
WEBHOOK_URL=https://doctor-money-production.up.railway.app

# Di production: salin connection string Supabase dari Connect → Session pooler.
# Ganti URL contoh di bawah seluruhnya; jangan gunakan URL transaction pooler.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Secret untuk validasi webhook dan pairing code.
APP_SECRET=replace-with-at-least-32-random-bytes
MODE=webhook
TZ=Asia/Jakarta
PORT=8080

# Opsional; tanpa API key, CoinGecko memakai endpoint publik dengan kuota terbatas.
COINGECKO_API_KEY=
SUPPORT_URL=

# Paket Pro manual. Pembayaran admin diverifikasi sebelum order diaktifkan.
PRO_PAYMENT_METHOD=
PRO_PAYMENT_ACCOUNT=
PRO_PAYMENT_ACCOUNT_NAME=
PRO_ADMIN_SECRET=

# SMTP untuk kode reset kata sandi melalui email. Simpan hanya di environment server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# WhatsApp lewat WasenderAPI (wasenderapi.com). Isi di service API; simpan hanya di environment server.
# API key sesi WhatsApp dari dashboard WasenderAPI.
WASENDER_API_KEY=
# Webhook Secret dari pengaturan sesi; dicocokkan dengan header X-Webhook-Signature.
WASENDER_WEBHOOK_SECRET=
# Nomor WhatsApp bot (format 62xxx) untuk ditampilkan di dashboard.
WHATSAPP_BOT_NUMBER=

# Doctor Money AI (robot pemeriksa keuangan). Tanpa ANTHROPIC_API_KEY, robot tampil tetapi pemeriksaan menjawab "belum diaktifkan".
ANTHROPIC_API_KEY=
# Opsional: batas pemeriksaan AI per akun per bulan.
AI_FREE_MONTHLY_LIMIT=3
AI_PRO_MONTHLY_LIMIT=60
