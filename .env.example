# Bot Telegram: ambil dari @BotFather.
BOT_TOKEN=

# URL Firebase Hosting untuk Mini App dan dashboard; juga menjadi origin CORS API.
WEBAPP_URL=https://YOUR_FIREBASE_PROJECT.web.app
# URL publik service API untuk webhook Telegram.
WEBHOOK_URL=https://doctor-money-production.up.railway.app

# Database utama: gunakan koneksi Postgres Supabase.
# Contoh format: postgresql+psycopg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Opsional: jika Anda ingin memakai Supabase client dari server.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secret untuk validasi webhook dan pairing code.
APP_SECRET=replace-with-at-least-32-random-bytes
MODE=webhook
TZ=Asia/Jakarta
PORT=8080

# Opsional; tanpa API key, CoinGecko memakai endpoint publik dengan kuota terbatas.
COINGECKO_API_KEY=
SUPPORT_URL=

# Paket Pro manual. Pembayaran admin diverifikasi sebelum order diaktifkan.
PRO_PAYMENT_METHOD=
PRO_PAYMENT_ACCOUNT=
PRO_PAYMENT_ACCOUNT_NAME=
PRO_ADMIN_SECRET=

# SMTP untuk kode reset kata sandi melalui email. Simpan hanya di environment server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_STARTTLS=true